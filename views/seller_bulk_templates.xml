<odoo>
    <template id="seller_products_import" name="Importar Productos">
        <t t-call="synara-marketplace.seller_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Importación Masiva de Productos</h2>
                    <a href="/mi/marketplace/productos" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"/>Volver
                    </a>
                </div>

                <div class="row">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 rounded-3 mb-4">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold mb-3">Subir Archivo CSV</h5>
                                <p class="text-muted small mb-4">
                                    Utilice esta herramienta para crear nuevos productos o actualizar los existentes de forma masiva. 
                                    El sistema utiliza la <strong>Referencia Interna</strong> para identificar productos existentes y actualizarlos.
                                </p>
                                
                                <form action="/mi/marketplace/productos/importar" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="mb-4 text-center p-5 border border-2 border-dashed rounded-3 bg-light">
                                        <i class="fa fa-file-excel-o fa-3x text-success mb-3 opacity-50"/>
                                        <div class="mb-3">
                                            <input type="file" name="csv_file" accept=".csv" class="form-control" required="required"/>
                                        </div>
                                        <small class="text-muted d-block mt-2">Sólo archivos .csv (separados por comas)</small>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fa fa-upload me-2"/>Procesar Importación
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 rounded-3 bg-light">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold">Instrucciones</h5>
                                <ol class="ps-3 mb-4">
                                    <li class="mb-2">Descargue la plantilla de ejemplo.</li>
                                    <li class="mb-2">Complete los datos (Referencia, Nombre, Precio, etc).</li>
                                    <li class="mb-2">Guarde como CSV.</li>
                                    <li>Suba el archivo y presione procesar.</li>
                                </ol>
                                <a href="/mi/marketplace/productos/plantilla_csv" class="btn btn-outline-success w-100">
                                    <i class="fa fa-download me-2"/>Descargar Plantilla CSV
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
