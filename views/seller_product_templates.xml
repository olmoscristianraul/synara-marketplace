<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Filtro de vendedores en la barra lateral del shop -->
    <template id="products_attributes_seller" inherit_id="website_sale.products_attributes">
        <xpath expr="//div[@id='wsale_products_attributes_collapse']" position="inside">
            <t t-if="marketplace_sellers">
                <div class="accordion-item nav-item mb-2 border-0">
                    <h6 class="accordion-header mb-0"><b>Vendedor</b></h6>
                    <div class="accordion-collapse collapse show">
                        <ul class="nav nav-pills flex-column mt-2">
                            <!-- Opción Todos -->
                            <li class="nav-item mb-1">
                                <div class="form-check d-inline-block">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="seller_id"
                                           value=""
                                           t-att-checked="'checked' if not selected_seller_id else None"
                                           id="seller_all"
                                           onchange="this.form.submit()"/>
                                    <label class="form-check-label fw-normal" for="seller_all">Todos</label>
                                </div>
                            </li>
                            <!-- Vendedores -->
                            <t t-foreach="marketplace_sellers" t-as="seller">
                                <li class="nav-item mb-1">
                                    <div class="form-check d-inline-block">
                                        <input type="radio"
                                               class="form-check-input"
                                               name="seller_id"
                                               t-att-value="seller.id"
                                               t-att-checked="'checked' if selected_seller_id == seller.id else None"
                                               t-att-id="'seller_%s' % seller.id"
                                               onchange="this.form.submit()"/>
                                        <label class="form-check-label fw-normal" t-att-for="'seller_%s' % seller.id">
                                            <t t-esc="seller.seller_store_name or seller.name"/>
                                        </label>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Nombre del vendedor en la tarjeta de producto (/shop) -->
    <template id="products_item_marketplace" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('product_price')]" position="before">
            <t t-if="product.marketplace_seller_id">
                <div class="text-muted small mt-1 mb-1">
                    <i class="fa fa-store me-1"/> <t t-esc="product.sudo().marketplace_seller_id.seller_store_name or product.sudo().marketplace_seller_id.name"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Nombre del vendedor en la página de detalle del producto -->
    <template id="product_marketplace" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_details']//h1" position="after">
            <t t-if="product.marketplace_seller_id">
                <div class="mb-3 text-muted">
                    <i class="fa fa-store me-2"/>Vendido por: 
                    <strong><t t-esc="product.sudo().marketplace_seller_id.seller_store_name or product.sudo().marketplace_seller_id.name"/></strong>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Seller Products List -->
    <template id="seller_products_list" name="Mis Productos">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-3">
                        <t t-call="synara-marketplace.seller_sidebar"/>
                    </div>
                    <div class="col-lg-9">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2><i class="fa fa-cubes me-2"/>Mis productos</h2>
                            <a href="/mi/marketplace/productos/nuevo" class="btn btn-primary">
                                <i class="fa fa-plus me-2"/>Nuevo Producto
                            </a>
                        </div>
                        
                        <t t-if="flash">
                            <div class="alert alert-success"><t t-esc="flash"/></div>
                        </t>

                        <t t-if="products">
                            <div class="row">
                                <t t-foreach="products" t-as="prod">
                                    <div class="col-md-4 mb-4">
                                        <div class="card h-100 shadow-sm">
                                            <img t-attf-src="/web/image/product.template/#{prod.id}/image_1024" class="card-img-top" style="height: 200px; object-fit: contain; padding: 10px;" alt="Producto"/>
                                            <div class="card-body">
                                                <h5 class="card-title text-truncate" t-att-title="prod.name"><t t-esc="prod.name"/></h5>
                                                <p class="card-text mb-1">
                                                    <strong>Monto:</strong> <t t-esc="prod.list_price" t-options="{'widget': 'monetary', 'display_currency': prod.currency_id}"/>
                                                </p>
                                                <p class="card-text mb-2">
                                                    <small class="text-muted">Stock disponible: <t t-esc="prod.qty_available"/></small>
                                                </p>
                                                <p class="card-text">
                                                    <t t-if="prod.marketplace_approved">
                                                        <span class="badge bg-success">Aprobado</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-warning text-dark">Pendiente por Admin</span>
                                                    </t>
                                                </p>
                                            </div>
                                            <div class="card-footer bg-white border-top-0 pt-0">
                                                <a t-attf-href="/mi/marketplace/productos/editar/#{prod.id}" class="btn btn-outline-secondary w-100">
                                                    <i class="fa fa-edit me-1"/> Editar
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-info py-5 text-center">
                                <h4>Aún no tienes productos</h4>
                                <p>Crea tu primer producto para empezar a vender en el Marketplace.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Seller Product Form -->
    <template id="seller_product_form" name="Formulario de Producto">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-3">
                        <t t-call="synara-marketplace.seller_sidebar"/>
                    </div>
                    <div class="col-lg-9">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2>
                                <t t-if="product.id">Editar Producto</t>
                                <t t-else="">Nuevo Producto</t>
                            </h2>
                            <a href="/mi/marketplace/productos" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-left me-2"/>Volver
                            </a>
                        </div>
                        
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-4 bg-light rounded">
                                <form method="POST" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold">Nombre del producto *</label>
                                            <input type="text" name="name" class="form-control" required="required" t-att-value="product.name if product.id else ''"/>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">Precio de Venta ($) *</label>
                                            <input type="number" step="0.01" min="0" name="list_price" class="form-control" required="required" t-att-value="product.list_price if product.id else ''"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">Stock / Cantidad *</label>
                                            <input type="number" step="1" min="0" name="stock_qty" class="form-control" required="required" t-att-value="current_stock" aria-describedby="stockHelp"/>
                                            <div id="stockHelp" class="form-text">Actualiza tu cantidad física disponible. Al guardarlo se ajustará tu inventario real automáticamente de fondo.</div>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold">Imagen principal</label>
                                            <input type="file" name="image_1920" class="form-control" accept="image/*"/>
                                            <t t-if="product.id and product.image_1920">
                                                <div class="mt-2 text-muted small"><i class="fa fa-info-circle me-1"/>Sube una nueva foto si quieres reemplazar la existente.</div>
                                            </t>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Descripción (visible en tienda)</label>
                                        <textarea name="description_sale" class="form-control" rows="5"><t t-esc="product.description_sale if product.id else ''"/></textarea>
                                    </div>
                                    
                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn btn-primary px-5 py-2">
                                            <i class="fa fa-save me-2"/>Guardar Producto
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
