<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Seller Registration & Dashboard Portal Templates     -->
    <!-- ══════════════════════════════════════════════════════ -->

    <!-- Registration Form -->
    <template id="seller_registration_form" name="Registro de vendedor">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card shadow-sm">
                            <div class="card-body p-4">
                                <h2 class="text-center mb-4">Registrate como vendedor</h2>
                                <p class="text-muted text-center mb-4">
                                    Creá tu tienda y empezá a vender. Conectá tu MercadoPago y recibí los pagos directamente.
                                </p>
                                <t t-if="errors">
                                    <div class="alert alert-danger">
                                        <ul class="mb-0">
                                            <t t-foreach="errors" t-as="err">
                                                <li><t t-esc="err"/></li>
                                            </t>
                                        </ul>
                                    </div>
                                </t>
                                <form method="POST" action="/mi/marketplace/registro">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Nombre completo *</label>
                                        <input type="text" class="form-control" id="name" name="name"
                                               t-att-value="values.get('name', '') if values else ''" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email *</label>
                                        <input type="email" class="form-control" id="email" name="email"
                                               t-att-value="values.get('email', '') if values else ''" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="store_name" class="form-label">Nombre de tu tienda *</label>
                                        <input type="text" class="form-control" id="store_name" name="store_name"
                                               t-att-value="values.get('store_name', '') if values else ''" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="phone" class="form-label">Teléfono</label>
                                        <input type="tel" class="form-control" id="phone" name="phone"
                                               t-att-value="values.get('phone', '') if values else ''"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="password" class="form-label">Contraseña *</label>
                                        <input type="password" class="form-control" id="password" name="password"
                                               required="required" minlength="6"/>
                                        <div class="form-text">Mínimo 6 caracteres</div>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 mt-3">
                                        <i class="fa fa-user-plus me-2"/>Crear mi cuenta
                                    </button>
                                </form>
                                <p class="text-center mt-3 text-muted">
                                    ¿Ya tenés cuenta? <a href="/web/login?redirect=/mi/marketplace/dashboard">Iniciá sesión</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Seller Suspended -->
    <template id="seller_suspended" name="Vendedor suspendido">
        <t t-call="website.layout">
            <div class="container py-5 text-center">
                <div class="alert alert-warning">
                    <h4><i class="fa fa-exclamation-triangle me-2"/>Tu cuenta de vendedor está suspendida</h4>
                    <p>Contactate con soporte para más información.</p>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_home_inherit" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div t-if="request.env.user.partner_id.is_marketplace_seller" class="alert alert-info d-flex justify-content-between align-items-center rounded-3 shadow-sm border-0 mb-4">
                <div>
                    <h4 class="alert-heading mb-1"><i class="fa fa-rocket me-2"/>Panel de Vendedor</h4>
                    <p class="mb-0">Gestione sus productos, pedidos y comisiones desde su panel exclusivo.</p>
                </div>
                <a href="/mi/marketplace/dashboard" class="btn btn-info px-4 fw-bold">Ir al Panel</a>
            </div>
        </xpath>
    </template>

    <!-- Shared Sidebar Navigation -->
    <template id="seller_sidebar" name="Sidebar vendedor">
        <div class="list-group mb-4">
            <a t-attf-href="/mi/marketplace/dashboard"
               t-attf-class="list-group-item list-group-item-action #{'active' if active_menu == 'dashboard' else ''}">
                <i class="fa fa-tachometer me-2"/>Dashboard
            </a>
            <a t-attf-href="/mi/marketplace/productos"
               t-attf-class="list-group-item list-group-item-action #{'active' if active_menu == 'products' else ''}">
                <i class="fa fa-cubes me-2"/>Mis productos
            </a>
            <a t-attf-href="/mi/marketplace/pedidos"
               t-attf-class="list-group-item list-group-item-action border-0 mb-1 rounded-3 #{'active' if active_menu == 'orders' else ''}">
                <i class="fa fa-shopping-cart me-2"/>Pedidos
                <t t-if="pending_deliveries">
                    <span class="badge rounded-pill bg-danger float-end"><t t-esc="pending_deliveries"/></span>
                </t>
            </a>
            <a t-attf-href="/mi/marketplace/comisiones"
               t-attf-class="list-group-item list-group-item-action #{'active' if active_menu == 'commissions' else ''}">
                <i class="fa fa-percent me-2"/>Comisiones
            </a>
            <a t-attf-href="/mi/marketplace/perfil"
               t-attf-class="list-group-item list-group-item-action #{'active' if active_menu == 'profile' else ''}">
                <i class="fa fa-user me-2"/>Mi perfil
            </a>
        </div>
    </template>

    <!-- Base Layout for Seller Portal -->
    <template id="seller_layout" name="Marketplace Seller Layout">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-3">
                        <t t-call="synara-marketplace.seller_sidebar"/>
                    </div>
                    <div class="col-lg-9">
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Dashboard -->
    <template id="seller_dashboard" name="Dashboard del vendedor">
        <t t-call="synara-marketplace.seller_layout">
            <h2 class="mb-4">
                <i class="fa fa-tachometer me-2"/>Dashboard
            </h2>

            <!-- Onboarding alert -->
            <t t-if="partner.seller_onboarding_state == 'pending_mp'">
                <div class="alert alert-warning border-0 shadow-sm rounded-3 py-3 mb-4">
                    <h5><i class="fa fa-exclamation-circle me-2"/>Conectá tu MercadoPago</h5>
                    <p class="mb-3 small">Para empezar a vender, necesitás conectar tu cuenta de MercadoPago.</p>
                    <a href="/mi/marketplace/perfil" class="btn btn-warning">
                        <i class="fa fa-credit-card me-2"/>Ir a mi perfil
                    </a>
                </div>
            </t>

            <!-- Stats Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1 small">Ventas totales</h6>
                            <h3 class="text-primary mb-0"><t t-esc="'${:,.2f}'.format(total_sales)"/></h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1 small">Comisiones</h6>
                            <h3 class="text-warning mb-0"><t t-esc="'${:,.2f}'.format(total_commissions)"/></h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1 small">Ganancias</h6>
                            <h3 class="text-success mb-0"><t t-esc="'${:,.2f}'.format(total_earnings)"/></h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-warning-subtle">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1 small">Por entregar</h6>
                            <h3 class="text-warning-emphasis fw-bold mb-0"><t t-esc="pending_deliveries or 0"/></h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Últimos pedidos</h5>
                </div>
                <div class="card-body p-0">
                    <t t-if="recent_orders">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Pedido</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end pe-4">Tu pago</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="recent_orders" t-as="order">
                                        <tr>
                                            <td class="ps-4">
                                                <a t-attf-href="/mi/marketplace/pedidos/#{order.id}">
                                                    <t t-esc="order.name"/>
                                                </a>
                                            </td>
                                            <td><t t-esc="order.date_order" t-options="{'widget': 'date'}"/></td>
                                            <td><t t-esc="order.partner_id.display_name"/></td>
                                            <td class="text-end">
                                                <t t-esc="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                            <td class="text-end text-success pe-4">
                                                <t t-esc="order.marketplace_seller_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="p-4 text-center text-muted">Aún no tienes ventas.</div>
                    </t>
                </div>
            </div>

            <!-- Assigned Products -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Tus productos principales</h5>
                </div>
                <div class="card-body p-0">
                    <t t-if="products">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Producto</th>
                                        <th class="text-end">Precio</th>
                                        <th>Categoría</th>
                                        <th class="pe-4">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="products" t-as="prod">
                                        <tr>
                                            <td class="ps-4"><t t-esc="prod.name"/></td>
                                            <td class="text-end">
                                                <t t-esc="prod.list_price" t-options="{'widget': 'monetary', 'display_currency': prod.currency_id}"/>
                                            </td>
                                            <td><t t-esc="prod.categ_id.display_name"/></td>
                                            <td class="pe-4">
                                                <t t-if="prod.website_published and prod.marketplace_approved">
                                                    <span class="badge text-bg-success rounded-pill">Publicado</span>
                                                </t>
                                                <t t-elif="not prod.marketplace_approved">
                                                    <span class="badge text-bg-warning rounded-pill">En revisión</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge text-bg-info rounded-pill">Aprobado</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="p-4 text-center text-muted">No tienes productos asignados todavía.</div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Profile -->
    <template id="seller_profile" name="Perfil del vendedor">
        <t t-call="synara-marketplace.seller_layout">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0"><i class="fa fa-user me-2"/>Mi perfil</h2>
                <t t-if="partner.mp_seller_account_status == 'connected'">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="fa fa-check-circle me-1"/> MercadoPago Conectado
                    </span>
                </t>
            </div>

            <t t-if="flash">
                <div class="alert alert-success border-0 shadow-sm rounded-3"><t t-esc="flash"/></div>
            </t>

            <div class="row g-4">
                <!-- Profile Settings -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold">Configuración de Tienda</h5>
                        </div>
                        <div class="card-body p-4">
                            <form method="POST" action="/mi/marketplace/perfil" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nombre Público de la Tienda</label>
                                    <input type="text" class="form-control bg-light" name="seller_store_name" t-att-value="partner.seller_store_name or ''"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Descripción / Bio</label>
                                    <textarea class="form-control bg-light" name="seller_description" rows="3"><t t-esc="partner.seller_description or ''"/></textarea>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Teléfono</label>
                                        <input type="tel" class="form-control bg-light" name="phone" t-att-value="partner.phone or ''"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Logo</label>
                                        <input type="file" class="form-control bg-light" name="seller_logo" accept="image/*"/>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary px-4 shadow-sm">Guardar Perfil</button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- MercadoPago Connection Card -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold">Pagos: MercadoPago</h5>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                            <t t-if="partner.mp_seller_account_status == 'connected'">
                                <div class="mb-3">
                                    <i class="fa fa-handshake-o fa-3x text-success opacity-50 mb-3"/>
                                    <h5 class="text-success fw-bold">¡Todo listo!</h5>
                                    <p class="text-muted small">Tus ventas se acreditan automáticamente en:</p>
                                    <code class="d-block py-2 bg-light rounded"><t t-esc="partner.mp_seller_account_email"/></code>
                                </div>
                                <a href="/mi/marketplace/mercadopago/desvincular" class="btn btn-outline-danger btn-sm mt-3" onclick="return confirm('¿Seguro quieres desvincular?');">Desvincular Cuenta</a>
                            </t>
                            <t t-else="">
                                <div class="mb-3">
                                    <i class="fa fa-link fa-3x text-muted opacity-50 mb-3"/>
                                    <h5>Vincula tu cuenta</h5>
                                    <p class="text-muted small">Necesitas MercadoPago para recibir pagos de tus clientes.</p>
                                </div>
                                <a t-att-href="connect_url" class="btn btn-info w-100 fw-bold shadow-sm">Conectar MercadoPago</a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Integrate with generic Odoo /my/account portal -->
    <template id="portal_my_details_mp_connect" inherit_id="portal.portal_my_details" name="Mercado Pago Connection">
        <xpath expr="//form" position="after">
            <t t-set="partner" t-value="request.env.user.partner_id"/>
            <div class="row mt-4 mb-5">
                <div class="col-lg-12">
                    <div class="card bg-light border-0 shadow-sm">
                        <div class="card-body">
                            <h4 class="mb-3"><i class="fa fa-handshake-o me-2"/>Mercado Pago: Cuenta de vendedor</h4>
                            <t t-if="not partner.is_marketplace_seller">
                                <p class="text-muted">Aún no eres un vendedor del marketplace. Para vender en esta plataforma y vincular Mercado Pago, debes aceptar los términos y registrarte.</p>
                                <a href="/mi/marketplace/registro" class="btn btn-outline-primary">Quiero ser vendedor</a>
                            </t>
                            <t t-if="partner.is_marketplace_seller">
                                <t t-if="partner.mp_seller_account_status == 'connected'">
                                    <div class="alert alert-success d-flex align-items-center mb-0">
                                        <i class="fa fa-check-circle fa-2x me-3"></i>
                                        <div>
                                            <h5 class="alert-heading mb-1">¡Cuenta conectada!</h5>
                                            <p class="mb-0">Tu Mercado Pago está vinculado correctamente. Estás listo para recibir pagos. 
                                            <t t-if="partner.mp_seller_account_email">
                                                <br/><small>(<t t-esc="partner.mp_seller_account_email"/>)</small>
                                            </t></p>
                                        </div>
                                        <div class="ms-auto">
                                            <a href="/mi/marketplace/mercadopago/desvincular" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro quieres desvincular tu cuenta de Mercado Pago? Ya no podrás recibir pagos.');">Desvincular</a>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <a href="/mi/marketplace/dashboard" class="btn btn-primary">Ir a mi Panel de Vendedor</a>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-warning d-flex align-items-center mb-0">
                                        <i class="fa fa-exclamation-triangle fa-2x me-3"></i>
                                        <div>
                                            <h5 class="alert-heading mb-1">Mercado Pago pendiente</h5>
                                            <p class="mb-1">Para recibir los pagos de las ventas de tus productos directamente a tu cuenta, debes autorizar la conexión.</p>
                                            <a href="/mi/marketplace/mercadopago/conectar" class="btn btn-primary mt-2">
                                                <i class="fa fa-link"></i> Vincular mi cuenta de Mercado Pago
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <a href="/mi/marketplace/dashboard" class="btn btn-secondary">Ir a mi Panel de Vendedor</a>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
