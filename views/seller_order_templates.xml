<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Seller Order Portal Templates                        -->
    <!-- ══════════════════════════════════════════════════════ -->

    <!-- Order List -->
    <template id="seller_orders" name="Pedidos del vendedor">
        <t t-call="synara-marketplace.seller_layout">
            <h2 class="mb-4"><i class="fa fa-shopping-cart me-2"/>Mis pedidos</h2>
            <t t-if="orders">
                <div t-if="request.session.pop('marketplace_product_flash', False)" class="alert alert-success border-0 shadow-sm mb-4">
                    <t t-esc="request.session.get('marketplace_product_flash')"/>
                </div>

                <div id="bulk_action_bar" class="card border-0 shadow-sm rounded-3 mb-3 bg-light d-none">
                    <div class="card-body py-2 d-flex align-items-center justify-content-between">
                        <span class="fw-bold text-primary"><i class="fa fa-check-square-o me-2"/><span id="selected_count">0</span> seleccionados</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-success" onclick="submitBulk('shipped')">Marcar Entregados</button>
                            <button type="button" class="btn btn-info text-white" onclick="submitBulk('invoiced')">Marcar Facturados</button>
                            <button type="button" class="btn btn-danger" onclick="submitBulk('cancelled')">Cancelar Seleccionados</button>
                        </div>
                    </div>
                </div>

                <form id="bulk_form" method="POST" action="/mi/marketplace/pedidos/bulk_status">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" id="bulk_status" name="status" value=""/>
                    <input type="hidden" id="bulk_order_ids" name="order_ids" value=""/>
                    
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4" style="width: 40px;">
                                            <input type="checkbox" id="select_all" onclick="toggleAll(this)"/>
                                        </th>
                                        <th>Pedido</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th class="text-end">Total venta</th>
                                        <th class="text-end">Tu pago</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="orders" t-as="order">
                                        <tr>
                                            <td class="ps-4">
                                                <input type="checkbox" name="order_check" t-att-value="order.id" onclick="updateSelection()"/>
                                            </td>
                                            <td>
                                                <a t-attf-href="/mi/marketplace/pedidos/#{order.id}" class="fw-bold">
                                                    <t t-esc="order.name"/>
                                                </a>
                                            </td>
                                            <td><t t-esc="order.date_order" t-options="{'widget': 'date'}"/></td>
                                            <td><t t-esc="order.partner_id.display_name"/></td>
                                            <td class="text-end">
                                                <t t-esc="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                            <td class="text-end text-success fw-bold">
                                                <t t-esc="order.marketplace_seller_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                            <td>
                                                <t t-if="order.marketplace_delivery_status == 'pending'">
                                                    <span class="badge rounded-pill bg-warning text-dark px-3">Pendiente Entrega</span>
                                                </t>
                                                <t t-elif="order.marketplace_delivery_status == 'shipped'">
                                                    <span class="badge rounded-pill bg-success px-3">Entregado</span>
                                                </t>
                                                <t t-elif="order.marketplace_delivery_status == 'cancelled'">
                                                    <span class="badge rounded-pill bg-danger px-3">Cancelado</span>
                                                </t>
                                                <t t-elif="order.marketplace_delivery_status == 'invoiced'">
                                                    <span class="badge rounded-pill bg-info px-3">Facturado</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>

                <script type="text/javascript">
                    function toggleAll(source) {
                        checkboxes = document.getElementsByName('order_check');
                        for(var i=0, n=checkboxes.length;i&lt;n;i++) {
                            checkboxes[i].checked = source.checked;
                        }
                        updateSelection();
                    }
                    function updateSelection() {
                        var checked = document.querySelectorAll('input[name="order_check"]:checked');
                        var bar = document.getElementById('bulk_action_bar');
                        var count = document.getElementById('selected_count');
                        count.innerHTML = checked.length;
                        if (checked.length > 0) {
                            bar.classList.remove('d-none');
                        } else {
                            bar.classList.add('d-none');
                        }
                    }
                    function submitBulk(status) {
                        var checked = document.querySelectorAll('input[name="order_check"]:checked');
                        var ids = Array.from(checked).map(cb => cb.value).join(',');
                        document.getElementById('bulk_status').value = status;
                        document.getElementById('bulk_order_ids').value = ids;
                        if (confirm('¿Aplicar cambio a ' + checked.length + ' pedidos?')) {
                            document.getElementById('bulk_form').submit();
                        }
                    }
                </script>
            </t>
            <t t-else="">
                <div class="alert alert-info text-center py-5 rounded-3 border-0 shadow-sm">
                    <i class="fa fa-shopping-basket fa-3x mb-3 text-info opacity-50"/>
                    <h4>No tenés pedidos todavía</h4>
                    <p class="text-muted">Tus ventas aparecerán aquí automáticamente.</p>
                </div>
            </t>
        </t>
    </template>

    <!-- Order Detail -->
    <template id="seller_order_detail" name="Detalle de pedido">
        <t t-call="synara-marketplace.seller_layout">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    Pedido <t t-esc="order.name"/>
                    <t t-if="order.marketplace_delivery_status == 'pending'">
                        <span class="badge rounded-pill bg-warning text-dark ms-2">Pendiente</span>
                    </t>
                    <t t-elif="order.marketplace_delivery_status == 'shipped'">
                        <span class="badge rounded-pill bg-success ms-2">Entregado</span>
                    </t>
                    <t t-elif="order.marketplace_delivery_status == 'cancelled'">
                        <span class="badge rounded-pill bg-danger ms-2">Cancelado</span>
                    </t>
                    <t t-elif="order.marketplace_delivery_status == 'invoiced'">
                        <span class="badge rounded-pill bg-info ms-2">Facturado</span>
                    </t>
                </h2>
                <div class="btn-group shadow-sm">
                    <t t-if="order.marketplace_delivery_status == 'pending'">
                        <button class="btn btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalDelivered">
                            <i class="fa fa-check me-1"/> Marcar Entregado
                        </button>
                        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancel">
                            <i class="fa fa-times me-1"/> Cancelar
                        </button>
                    </t>
                    <t t-if="order.marketplace_delivery_status in ['pending', 'shipped']">
                        <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalInvoice">
                            <i class="fa fa-file-text me-1"/> Facturar
                        </button>
                    </t>
                </div>
            </div>

            <t t-if="flash">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4">
                    <i class="fa fa-check-circle me-2"/> <t t-esc="flash"/>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </t>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header"><h5 class="mb-0">Datos del cliente</h5></div>
                                    <div class="card-body">
                                        <p><strong>Nombre:</strong> <t t-esc="order.partner_id.display_name"/></p>
                                        <p><strong>Email:</strong> <t t-esc="order.partner_id.email or 'N/A'"/></p>
                                        <p><strong>Teléfono:</strong> <t t-esc="order.partner_id.phone or 'N/A'"/></p>
                                        <t t-if="order.partner_shipping_id">
                                            <hr/>
                                            <p><strong>Dirección de envío:</strong></p>
                                            <address>
                                                <t t-esc="order.partner_shipping_id.street or ''"/><br/>
                                                <t t-esc="order.partner_shipping_id.city or ''"/>
                                                <t t-if="order.partner_shipping_id.state_id">,
                                                    <t t-esc="order.partner_shipping_id.state_id.name"/>
                                                </t><br/>
                                                <t t-esc="order.partner_shipping_id.zip or ''"/>
                                                <t t-if="order.partner_shipping_id.country_id">
                                                    - <t t-esc="order.partner_shipping_id.country_id.name"/>
                                                </t>
                                            </address>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header"><h5 class="mb-0">Resumen financiero</h5></div>
                                    <div class="card-body">
                                        <p>
                                            <strong>Total de la venta:</strong>
                                            <span class="float-end">
                                                <t t-esc="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </span>
                                        </p>
                                        <p>
                                            <strong>Comisión plataforma (<t t-esc="order.marketplace_commission_percent"/>%):</strong>
                                            <span class="float-end text-warning">
                                                - <t t-esc="order.marketplace_platform_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </span>
                                        </p>
                                        <hr/>
                                        <p class="h5">
                                            <strong>Tu pago:</strong>
                                            <span class="float-end text-success">
                                                <t t-esc="order.marketplace_seller_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Lines -->
                        <div class="card">
                            <div class="card-header"><h5 class="mb-0">Productos</h5></div>
                            <div class="card-body p-0">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-center">Cantidad</th>
                                            <th class="text-end">Precio unitario</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="order.order_line" t-as="line">
                                            <tr>
                                                <td><t t-esc="line.product_id.display_name"/></td>
                                                <td class="text-center"><t t-esc="int(line.product_uom_qty)"/></td>
                                                <td class="text-end">
                                                    <t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Modals de Acciones sobre el Pedido -->
                        <div class="modal fade" id="modalDelivered" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Confirmar Entrega</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        ¿Estás seguro que deseas marcar este pedido como entregado? Esto notificará a la plataforma que el producto ya fue despachado.
                                    </div>
                                    <div class="modal-footer">
                                        <form method="POST" t-attf-action="/mi/marketplace/pedidos/#{order.id}/estado">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="status" value="shipped"/>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            <button type="submit" class="btn btn-success">Confirmar Entrega</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Cancelar -->
                        <div class="modal fade" id="modalCancel" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <div class="modal-header">
                                        <h5 class="modal-title">¿Cancelar este pedido?</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        Esta acción no se puede deshacer. Se notificará a la plataforma que el pedido no podrá ser entregado.
                                    </div>
                                    <div class="modal-footer">
                                        <form method="POST" t-attf-action="/mi/marketplace/pedidos/#{order.id}/estado">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="status" value="cancelled"/>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            <button type="submit" class="btn btn-danger">Confirmar Cancelación</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="modalInvoice" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form method="POST" t-attf-action="/mi/marketplace/pedidos/#{order.id}/subir_factura" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="modal-header">
                                            <h5 class="modal-title">Subir Factura</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label">Archivo PDF / Imagen</label>
                                                <input class="form-control" type="file" name="invoice_file" required="required"/>
                                            </div>
                                            <p class="text-muted small">El administrador y el cliente podrán descargar este documento desde el seguimiento del pedido.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-primary">Subir Archivo</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

        </t>
    </template>
</odoo>
