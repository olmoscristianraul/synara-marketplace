<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Commission Rule Views                                -->
    <!-- ══════════════════════════════════════════════════════ -->

    <record id="view_commission_rule_tree" model="ir.ui.view">
        <field name="name">marketplace.commission.rule.tree</field>
        <field name="model">marketplace.commission.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de comisión" editable="bottom">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="commission_percent"/>
                <field name="category_id"/>
                <field name="seller_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_rule_form" model="ir.ui.view">
        <field name="name">marketplace.commission.rule.form</field>
        <field name="model">marketplace.commission.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de comisión">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="commission_percent"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="seller_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_rules" model="ir.actions.act_window">
        <field name="name">Reglas de comisión</field>
        <field name="res_model">marketplace.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Commission Line Views                                -->
    <!-- ══════════════════════════════════════════════════════ -->

    <record id="view_commission_line_tree" model="ir.ui.view">
        <field name="name">marketplace.commission.line.tree</field>
        <field name="model">marketplace.commission.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de comisión">
                <field name="sale_date"/>
                <field name="seller_id"/>
                <field name="sale_order_name"/>
                <field name="sale_amount" sum="Total ventas"/>
                <field name="commission_percent"/>
                <field name="commission_amount" sum="Total comisiones"/>
                <field name="seller_amount" sum="Total vendedor"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'paid'"
                       decoration-warning="state == 'pending'"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_commission_line_form" model="ir.ui.view">
        <field name="name">marketplace.commission.line.form</field>
        <field name="model">marketplace.commission.line</field>
        <field name="arch" type="xml">
            <form string="Línea de comisión">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="seller_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_date"/>
                        </group>
                        <group>
                            <field name="sale_amount"/>
                            <field name="commission_percent"/>
                            <field name="commission_amount"/>
                            <field name="seller_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="invoice_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_line_search" model="ir.ui.view">
        <field name="name">marketplace.commission.line.search</field>
        <field name="model">marketplace.commission.line</field>
        <field name="arch" type="xml">
            <search string="Buscar comisiones">
                <field name="seller_id"/>
                <field name="sale_order_name"/>
                <separator/>
                <filter string="Pendientes" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Facturadas" name="filter_invoiced"
                        domain="[('state', '=', 'invoiced')]"/>
                <filter string="Pagadas" name="filter_paid"
                        domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="Este mes" name="filter_this_month"
                        domain="[('sale_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vendedor" name="group_seller"
                            context="{'group_by': 'seller_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Mes" name="group_month"
                            context="{'group_by': 'sale_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_lines" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="res_model">marketplace.commission.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_line_search"/>
    </record>

    <record id="action_bulk_invoice_commissions" model="ir.actions.server">
        <field name="name">Facturar comisiones</field>
        <field name="model_id" ref="model_marketplace_commission_line"/>
        <field name="binding_model_id" ref="model_marketplace_commission_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('group_marketplace_admin'))]"/>
        <field name="code">
            action = records.action_generate_invoices()
        </field>
    </record>
</odoo>
