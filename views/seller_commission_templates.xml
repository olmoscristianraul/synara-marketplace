<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="seller_commissions" name="Comisiones del vendedor">
        <t t-call="synara-marketplace.seller_layout">
            <h2 class="mb-4"><i class="fa fa-percent me-2"/>Mis comisiones</h2>

            <t t-if="commission_lines">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-1 small text-uppercase fw-bold">Pendientes de cobro</h6>
                                <h4 class="text-warning mb-0">
                                    <t t-esc="'${:,.2f}'.format(sum(commission_lines.filtered(lambda l: l.state == 'pending').mapped('commission_amount')))"/>
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-1 small text-uppercase fw-bold">Total facturado</h6>
                                <h4 class="text-success mb-0">
                                    <t t-esc="'${:,.2f}'.format(sum(commission_lines.filtered(lambda l: l.state == 'invoiced').mapped('commission_amount')))"/>
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 text-center border-0 shadow-sm rounded-3 bg-white">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-1 small text-uppercase fw-bold">Liquidadas (Pago)</h6>
                                <h4 class="text-info mb-0">
                                    <t t-esc="'${:,.2f}'.format(sum(commission_lines.filtered(lambda l: l.state == 'paid').mapped('commission_amount')))"/>
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3 overflow-hidden mt-4">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Fecha</th>
                                    <th>Pedido</th>
                                    <th class="text-end">Venta Bruta</th>
                                    <th class="text-center">Comision %</th>
                                    <th class="text-end">Comision</th>
                                    <th class="text-end">Tu pago neto</th>
                                    <th class="pe-4">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="commission_lines" t-as="line">
                                    <tr>
                                        <td class="ps-4"><t t-esc="line.sale_date" t-options="{'widget': 'date'}"/></td>
                                        <td><t t-esc="line.sale_order_name"/></td>
                                        <td class="text-end">
                                            <t t-esc="line.sale_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td class="text-center"><t t-esc="line.commission_percent"/>%</td>
                                        <td class="text-end text-warning">
                                            <t t-esc="line.commission_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td class="text-end text-success fw-bold">
                                            <t t-esc="line.seller_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                        </td>
                                        <td class="pe-4">
                                            <t t-if="line.state == 'pending'">
                                                <span class="badge rounded-pill bg-warning text-dark">Pendiente</span>
                                            </t>
                                            <t t-elif="line.state == 'invoiced'">
                                                <span class="badge rounded-pill bg-success mb-1">Facturada</span>
                                                <t t-if="line.invoice_id">
                                                    <a t-attf-href="/my/invoices/#{line.invoice_id.id}" class="d-block text-decoration-none small" target="_blank">
                                                        <i class="fa fa-file-pdf-o me-1 text-danger"/>
                                                        <t t-esc="line.invoice_id.name"/>
                                                    </a>
                                                </t>
                                            </t>
                                            <t t-elif="line.state == 'paid'">
                                                <span class="badge rounded-pill bg-info">Pago</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-info text-center py-5 rounded-3 border-0 shadow-sm bg-white">
                    <i class="fa fa-percent fa-3x mb-3 text-info opacity-50"/>
                    <h4 class="fw-bold">No tenes comisiones registradas</h4>
                    <p class="text-muted mb-0">Las comisiones se generan automaticamente con cada venta.</p>
                </div>
            </t>
        </t>
    </template>
</odoo>
