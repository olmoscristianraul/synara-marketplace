<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════ -->
    <!--  Seller Commission Portal Templates                   -->
    <!-- ══════════════════════════════════════════════════════ -->

    <template id="seller_commissions" name="Comisiones del vendedor">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-3">
                        <t t-call="synara-marketplace.seller_sidebar"/>
                    </div>
                    <div class="col-lg-9">
                        <h2 class="mb-4"><i class="fa fa-percent me-2"/>Mis comisiones</h2>

                        <t t-if="commission_lines">
                            <!-- Summary Cards -->
                            <div class="row mb-4">
                                <div class="col-md-4 mb-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h6 class="text-muted">Comisiones pendientes</h6>
                                            <h4 class="text-warning">
                                                <t t-esc="'${:,.2f}'.format(sum(commission_lines.filtered(lambda l: l.state == 'pending').mapped('commission_amount')))"/>
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h6 class="text-muted">Comisiones facturadas</h6>
                                            <h4 class="text-success">
                                                <t t-esc="'${:,.2f}'.format(sum(commission_lines.filtered(lambda l: l.state == 'invoiced').mapped('commission_amount')))"/>
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="card text-center">
                                        <div class="card-body">
                                            <h6 class="text-muted">Total ganado</h6>
                                            <h4 class="text-primary">
                                                <t t-esc="'${:,.2f}'.format(sum(commission_lines.mapped('seller_amount')))"/>
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Line Detail -->
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Pedido</th>
                                            <th class="text-end">Venta</th>
                                            <th class="text-center">Comisión %</th>
                                            <th class="text-end">Comisión</th>
                                            <th class="text-end">Tu pago</th>
                                            <th>Estado</th>
                                            <th>Factura</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="commission_lines" t-as="line">
                                            <tr>
                                                <td><t t-esc="line.sale_date" t-options="{'widget': 'date'}"/></td>
                                                <td><t t-esc="line.sale_order_name"/></td>
                                                <td class="text-end">
                                                    <t t-esc="line.sale_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-esc="line.commission_percent"/>%
                                                </td>
                                                <td class="text-end text-warning">
                                                    <t t-esc="line.commission_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <td class="text-end text-success">
                                                    <t t-esc="line.seller_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <td>
                                                    <t t-if="line.state == 'pending'">
                                                        <span class="badge text-bg-warning">Pendiente</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge text-bg-success">Facturada</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="line.invoice_id">
                                                        <t t-esc="line.invoice_id.name"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-info text-center py-5">
                                <h4>No tenés comisiones registradas</h4>
                                <p>Las comisiones se generan automáticamente con cada venta.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
